{
    "@context": "https://w3id.org/ro/crate/1.3/context",
    "@graph": [
        {
            "@id": "ro-crate-metadata.json",
            "@type": "CreativeWork",
            "about": {
                "@id": "./"
            },
            "creator":{
                "@id": "https://orcid.org/0000-0001-8327-0142"
            },
            "conformsTo": {
                "@id": "https://w3id.org/ro/crate/1.3"
            }
        },
        {
            "@id": "./",
            "@type": [
                "Dataset",
                "Profile"
            ],
            "identifier": "{{root.identifier}}",
            "version": "0.1.0",
            "distribution": {"@id": "mrc-profile-0.1.zip"},
            "author": {"@id": "https://orcid.org/0000-0001-8327-0142"},
            "name": "VLIZ MRC RO Crate Profile",
            "description": "RO Crate Profile to package and publish all datasets generated by the activities of VLIZ Marine Robotics Center.",
            "license": {"@id": "https://creativecommons.org/publicdomain/zero/1.0/"},
            "datePublished": "2026-10-01",
            "hasPart": [
                {"@id": "mrco.shacl.ttl"},
                { "@id": "mrco.profile.vocab.ttl" }
            ],

            "hasResource": [
                { "@id": "#hasShape" },
                { "@id": "#hasVocabulary" },
                { "@id": "#hasClosureGraph" }
            ]        
        },
        { 
            "@id": "#hasShape",
            "@type": "ResourceDescriptor",
            "hasRole": { "@id": "http://www.w3.org/ns/dx/prof/role/constraints" },
            "hasArtifact": {"@id": "mrco.shacl.ttl"}
        },
        {
            "@id": "mrco.shacl.ttl",
            "@type": "File",
            "description": "SHACL shapes constraining all triples contained in any mrc-ro-crate.",
            "name": "marine robotics center SHACL shapes",
            "identifier": "https://infra.vliz.be/schema/mrco",
            "sameAs": {"@id": "https://infra.vliz.be/schema/mrco"},
            "encodingFormat": "text/turtle",
            "conformsTo": "https://www.w3.org/TR/shacl/"
        },
        {
        "@id": "#hasVocabulary",
        "@type": "ResourceDescriptor",
        "hasRole": { "@id": "http://www.w3.org/ns/dx/prof/role/vocabulary" },
        "hasArtifact": { "@id": "mrco.profile.vocab.ttl" },
        "description": "Vocabulary defining the resource roles introduced by this profile, notably the closureGraph role."
        },
        {
        "@id": "#hasClosureGraph",
        "@type": "ResourceDescriptor",
        "hasRole": { "@id": "{{profile-vocab.closureid}}" },
        "description": "OPTIONAL. A conforming crate MAY contain one closure graph: an RDF file describing every resource of the namespace https://infra.mrc.vliz.be/ used in this crate. If present, it SHOULD validate against mrco.shacl.ttl.",
        "conformsTo": { "@id": "mrco.shacl.ttl" }
        },
        {
        "@id": "mrco.profile.vocab.ttl",
        "@type": "File",
        "name": "MRCO profile vocabulary",
        "description": "Defines the closureGraph resource role and the properties used to describe it.",
        "encodingFormat": "text/turtle",
        "sameAs": { "@id": "{{profile-vocab.id}}" },
        "contentUrl": "{{profile-vocab.id}}"    
        },
        { 
            "@id": "mrc-profile-0.1.zip",
            "@type": "DataDownload",
            "encodingFormat": ["application/zip", {"@id": "https://www.nationalarchives.gov.uk/PRONOM/x-fmt/263"}],
            "conformsTo": { "@id": "https://w3id.org/ro/crate" }
            "downloadUrl": "{{profile.downloadUrl}}"
        },
        {
        "@id": "https://orcid.org/0000-0001-8327-0142",
        "@type": "Person"
        }
    ]
}