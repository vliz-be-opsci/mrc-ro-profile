RewriteEngine on

# Redirect to GitHub Pages base URL
SetEnv BASE https://vliz-be-opsci.github.io/mrc-crate

# Content negotiation for versioned profile URIs
# Accept application/ld+json → JSON metadata
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^vliz-be-opsci/crate-profiles/mrc-ro-profile/([0-9]+(\.[0-9]+))$ %{ENV:BASE}/$1/ro-crate-metadata.json [R=303,L]

# Accept text/turtle → SHACL shapes
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^vliz-be-opsci/crate-profiles/mrc-ro-profile/([0-9]+(\.[0-9]+))$ %{ENV:BASE}/$1/mrco.shacl.ttl [R=303,L]

# Default: serve HTML specification
RewriteRule ^vliz-be-opsci/crate-profiles/mrc-ro-profile/([0-9]+(\.[0-9]+))$ %{ENV:BASE}/$1/index.html [R=303,L]
